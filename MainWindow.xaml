<Window x:Class="AquaVectorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AquaVectorUI.viewmodel"
        xmlns:views="clr-namespace:AquaVectorUI.views"
        Title="수중 무기 통제 시스템 (UWS-CTRL)"
        MinWidth="1100" MinHeight="700"
        Background="#0d1520">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="260" MinHeight="80"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="425" MinWidth="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"   MinWidth="420"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="215" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: COMM + LiDAR PPI -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="210"/>
                <RowDefinition Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>
            <views:CommPanel       Grid.Row="0"/>
            <views:AcousticSpectrumControl Grid.Row="1"
                                           IsMonitoringEnabled="{Binding IsAcousticMonitoringEnabled}"/>
            <views:LidarPpiControl Grid.Row="2"/>
        </Grid>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="#1e3050" ResizeBehavior="PreviousAndNext"/>

        <!-- CENTER: Global map -->
        <views:GlobalMapControl Grid.Row="0" Grid.Column="2"/>

        <GridSplitter Grid.Row="0" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                      Background="#1e3050" ResizeBehavior="PreviousAndNext"/>

        <!-- RIGHT: Control panels -->
        <ScrollViewer Grid.Row="0" Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <views:SystemStatusPanel/>
                <views:ActuatorControlPanel/>
                <!-- <views:LaunchControlPanel/> -->
                <views:TorpedoFirePanel/>
                <!-- <views:PathControlPanel/> -->
                <views:TerminalGuidancePanel/>
            </StackPanel>
        </ScrollViewer>

        <!-- Horizontal splitter between main content and log -->
        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                      Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#1e3050" ResizeBehavior="PreviousAndNext"/>

        <!-- LOG: Full-width across all columns -->
        <views:ReceiveLogControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"/>
    </Grid>
</Window>
