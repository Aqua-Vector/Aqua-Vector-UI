<UserControl x:Class="AquaVectorUI.views.AcousticSpectrumControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Border Style="{StaticResource PanelBorder}"
            Background="#101922"
            Padding="0,2,0,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="▸ ACOUSTIC ANALYZER"
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="StatusLabel"
                           Grid.Column="1"
                           Text="WAITING"
                           Foreground="#a0b8cc"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="8,6,8,4"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="8,0,8,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Margin="0,1,5,1">
                    <TextBlock Text="dBFS 0"
                               Foreground="#5f7484"
                               FontFamily="Consolas"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                    <TextBlock Text="-50"
                               Foreground="#5f7484"
                               FontFamily="Consolas"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="-100"
                               Foreground="#5f7484"
                               FontFamily="Consolas"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>
                </Grid>

                <Canvas x:Name="SpectrumCanvas"
                        Grid.Column="1"
                        MinHeight="94"
                        Background="#071018"
                        ClipToBounds="True"
                        SizeChanged="SpectrumCanvas_SizeChanged">
                    <Line x:Name="GridLine20" Stroke="#1e3050" StrokeThickness="1" Opacity="0.75"/>
                    <Line x:Name="GridLine40" Stroke="#1e3050" StrokeThickness="1" Opacity="0.75"/>
                    <Line x:Name="GridLine60" Stroke="#1e3050" StrokeThickness="1" Opacity="0.75"/>
                    <Line x:Name="GridLine80" Stroke="#1e3050" StrokeThickness="1" Opacity="0.75"/>
                    <Polyline x:Name="SpectrumLineLeft"
                              Stroke="#00d5e6"
                              StrokeThickness="1.8"/>
                    <Polyline x:Name="SpectrumLineRight"
                              Stroke="#ffb000"
                              StrokeThickness="1.6"
                              StrokeDashArray="4,3"
                              Opacity="0.95"/>
                    <Line x:Name="TargetGuide"
                          Stroke="#66ffff"
                          StrokeDashArray="2,2"
                          StrokeThickness="1"/>
                    <Line x:Name="SecondaryTargetGuide"
                          Stroke="#b7ff66"
                          StrokeDashArray="2,2"
                          StrokeThickness="1"/>
                    <Line x:Name="TargetTrackingGuide"
                          Stroke="#ffb000"
                          StrokeDashArray="4,2"
                          StrokeThickness="1"/>
                    <Line x:Name="SecondaryTrackingGuide"
                          Stroke="#ffb000"
                          StrokeDashArray="4,2"
                          StrokeThickness="1"/>
                    <TextBlock x:Name="TargetTrackTag"
                               Text="500"
                               Foreground="#ffb000"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Padding="3,0"
                               Canvas.Top="4"/>
                    <TextBlock x:Name="SecondaryTrackTag"
                               Text="700"
                               Foreground="#ffb000"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Padding="3,0"
                               Canvas.Top="4"/>
                    <TextBlock x:Name="FStartLabel"
                               Text=""
                               Foreground="#5f7484"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="9"
                               Padding="2,0"
                               Canvas.Bottom="1"/>
                    <TextBlock x:Name="TargetFreqLabel"
                               Text="500"
                               Foreground="#66ffff"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Padding="2,0"
                               Canvas.Bottom="1"/>
                    <TextBlock x:Name="SecondaryTargetFreqLabel"
                               Text="700"
                               Foreground="#b7ff66"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Padding="2,0"
                               Canvas.Bottom="1"/>
                    <TextBlock x:Name="FEndLabel"
                               Text="3k"
                               Foreground="#5f7484"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="9"
                               Padding="2,0"
                               Canvas.Bottom="1"/>
                    <TextBlock x:Name="FrequencyUnitLabel"
                               Text="Hz"
                               Foreground="#7ec8e3"
                               Background="#071018"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Padding="2,0"
                               Canvas.Bottom="1"/>
                </Canvas>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MetricsLabel"
                           Grid.Row="0"
                           Grid.Column="0"
                           Text="SNR -- dB | L -- dBFS | R -- dBFS"
                           Foreground="#d7e4ee"
                           FontFamily="Consolas"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DirectionLabel"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="CENTER"
                           Foreground="#ffb000"
                           FontFamily="Consolas"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="8,0,0,0"/>

                <TextBlock x:Name="PeakLabel"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="Peak -- Hz | Confidence --%"
                           Foreground="#7ec8e3"
                           FontFamily="Consolas"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
