<UserControl x:Class="AquaVectorUI.views.GlobalMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Map header -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="0,4,0,4" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MapTitleText" Grid.Column="0" Text="▸ 전역 맵"
                           Style="{StaticResource SectionTitle}" Margin="8,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#00ff88" Margin="0,0,3,0"/>
                    <TextBlock Text="어뢰"   Foreground="#a0b8cc" FontFamily="Consolas" FontSize="10" Margin="0,0,12,0"/>
                    <Path Data="M5,0 L10,9 L0,9 Z" Fill="#ff3333" Width="9" Height="9" Stretch="Fill" Margin="0,0,3,0"/>
                    <TextBlock Text="목표"   Foreground="#a0b8cc" FontFamily="Consolas" FontSize="10" Margin="0,0,12,0"/>
                    <Rectangle Width="8" Height="8" Fill="#ffaa00" Margin="0,0,3,0"/>
                    <TextBlock Text="장애물" Foreground="#a0b8cc" FontFamily="Consolas" FontSize="10" Margin="0,0,12,0"/>
                    <Line X1="0" Y1="4" X2="16" Y2="4" Stroke="#00ccff" StrokeThickness="1.5"
                          StrokeDashArray="4 2" Width="16" Height="8" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBlock Text="예측 경로" Foreground="#a0b8cc" FontFamily="Consolas" FontSize="10" Margin="0,0,12,0"/>
                    <Line X1="0" Y1="4" X2="16" Y2="4" Stroke="#00ff88" StrokeThickness="1.5"
                          Width="16" Height="8" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBlock Text="이동 경로" Foreground="#a0b8cc" FontFamily="Consolas" FontSize="10" Margin="0,0,12,0"/>
                    <!--
                    <TextBlock Text="+" Foreground="#44aaff" FontFamily="Consolas" FontSize="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBlock Text="선택"   Foreground="#a0b8cc" FontFamily="Consolas" FontSize="10"/>
                    -->
                </StackPanel>
                
                <!--

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="선택: " Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding SelectedCoordText}" Foreground="#44aaff"
                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="  커서: " Style="{StaticResource FieldLabel}" Margin="10,0,4,0"/>
                    <TextBlock Text="{Binding HoverCoordText}" Foreground="#558888"
                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" MinWidth="100"/>
                </StackPanel>
                
                <Button Grid.Column="3" x:Name="MapResetBtn" Content="Reset" Click="MapReset_Click"
                        FontFamily="Consolas" FontSize="10" Cursor="Hand"
                        Background="#081008" Foreground="#336633" BorderBrush="#1a3a1a"
                        BorderThickness="1" Padding="6,1" Margin="6,0,4,0" VerticalAlignment="Center"/>
                -->
            </Grid>
        </Border>

        <!-- Canvas 460×460 · scaleX=105px/m scaleY=60px/m · origin (230,440) at default · scroll-zoom to cursor -->
        <Border Grid.Row="1" Background="Black" CornerRadius="4" BorderBrush="#1e3050" BorderThickness="1">
            <Viewbox Stretch="Uniform" Margin="8">
                <Canvas x:Name="MapCanvas" Width="460" Height="460"
                        MouseLeftButtonDown="MapCanvas_MouseDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseWheel="MapCanvas_MouseWheel">

                    <Rectangle Width="460" Height="460" Fill="#04080f"/>
                    <Rectangle Canvas.Left="20" Canvas.Top="20" Width="420" Height="420" Fill="#060c0a"/>

                    <!-- Dynamic grid and axis label layers -->
                    <Canvas x:Name="GridCanvas"      Width="460" Height="460" IsHitTestVisible="False"/>
                    <Canvas x:Name="AxisLabelCanvas" Width="460" Height="460" IsHitTestVisible="False"/>

                    <!-- Rear area indicator -->
                    <TextBlock Text="▼ 후방 (표시 안됨)" Canvas.Left="175" Canvas.Top="449"
                               Foreground="#1a2a1a" FontFamily="Consolas" FontSize="8"/>

                    <!-- Origin dot at world (0,0) — position updated in code-behind -->
                    <Ellipse x:Name="OriginDot" Canvas.Left="226" Canvas.Top="436" Width="8" Height="8"
                             Fill="#00ff88" Stroke="#00bb66" StrokeThickness="1"/>

                    <!-- Dynamic object layers -->
                    <Canvas x:Name="ObstacleCanvas" Width="460" Height="460"/>

                    <Polyline x:Name="PathPolyline" Stroke="#ffaa00" StrokeThickness="1.5"
                              StrokeDashArray="4 3" Opacity="0.75"/>

                    <Polyline x:Name="TrailPolyline" Stroke="#00ff88" StrokeThickness="1.5" Opacity="0.40"/>

                    <Polyline x:Name="PredictedPathPolyline" Stroke="#00ccff" StrokeThickness="1.5"
                              StrokeDashArray="6 3" Opacity="0.45"/>

                    <Line x:Name="AimLine" Stroke="#4488ff" StrokeThickness="1"
                          StrokeDashArray="5 4" Opacity="0"
                          X1="230" Y1="440" X2="230" Y2="440"/>

                    <Canvas x:Name="TargetCanvas">
                        <Polygon x:Name="TargetMarker" Points="10,0 20,18 0,18"
                                 Fill="#cc1111" Stroke="#ff5555" StrokeThickness="1.5" Opacity="0.9"/>
                        <TextBlock x:Name="TargetLabel" Text="TGT"
                                   Foreground="#ff8888" FontFamily="Consolas" FontSize="9"/>
                    </Canvas>

                    <Canvas x:Name="SelectedCanvas" Visibility="Hidden">
                        <Line X1="-7" Y1="0" X2="7" Y2="0"  Stroke="#44aaff" StrokeThickness="1.5"/>
                        <Line X1="0"  Y1="-7" X2="0" Y2="7" Stroke="#44aaff" StrokeThickness="1.5"/>
                        <Ellipse Width="14" Height="14" Stroke="#44aaff" StrokeThickness="1"
                                 Fill="Transparent" Canvas.Left="-7" Canvas.Top="-7"/>
                    </Canvas>

                    <Canvas x:Name="TorpedoCanvas">
                        <Ellipse x:Name="TorpedoMarker" Width="14" Height="14"
                                 Fill="#00ff88" Stroke="#00aa66" StrokeThickness="1.5"/>
                        <Line x:Name="TorpedoHeadingLine" Stroke="#00ff88" StrokeThickness="2"
                              X1="7" Y1="7" X2="7" Y2="-15"/>
                        <Polygon x:Name="TorpedoArrow" Fill="#00ff88"/>
                        <TextBlock x:Name="TorpedoLabel" Text="TRP"
                                   Foreground="#88ffcc" FontFamily="Consolas" FontSize="9"/>
                    </Canvas>

                    <!-- Info overlay — shown when a map object is clicked -->
                    <Border x:Name="InfoOverlay" Visibility="Collapsed"
                            Background="#E8020c18" BorderBrush="#44aaff" BorderThickness="1"
                            CornerRadius="3" Padding="8,6" MinWidth="118"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock x:Name="InfoTypeLabel"
                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="InfoLine1" FontFamily="Consolas" FontSize="9" Foreground="#b0c8dc"/>
                            <TextBlock x:Name="InfoLine2" FontFamily="Consolas" FontSize="9" Foreground="#b0c8dc"/>
                            <TextBlock x:Name="InfoLine3" FontFamily="Consolas" FontSize="9" Foreground="#b0c8dc"/>
                            <TextBlock x:Name="InfoLine4" FontFamily="Consolas" FontSize="9" Foreground="#b0c8dc"/>
                        </StackPanel>
                    </Border>

                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
