<UserControl x:Class="AquaVectorUI.views.LidarPpiControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Border Style="{StaticResource PanelBorder}"
            Background="Black">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="▸ LIDAR PPI · 전방 180°"
                           Style="{StaticResource SectionTitle}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Button x:Name="PpiZoom1x"
                            Content="×1"
                            Tag="1"
                            Click="PpiZoom_Click"
                            FontFamily="Consolas"
                            FontSize="10"
                            Cursor="Hand"
                            Background="#081008"
                            Foreground="#336633"
                            BorderBrush="#1a3a1a"
                            BorderThickness="1"
                            Padding="5,1"
                            Margin="1,0,0,0" />
                    <Button x:Name="PpiZoom2x"
                            Content="×2"
                            Tag="2"
                            Click="PpiZoom_Click"
                            FontFamily="Consolas"
                            FontSize="10"
                            Cursor="Hand"
                            Background="#081008"
                            Foreground="#336633"
                            BorderBrush="#1a3a1a"
                            BorderThickness="1"
                            Padding="5,1"
                            Margin="1,0,0,0" />
                    <Button x:Name="PpiZoom4x"
                            Content="×4"
                            Tag="4"
                            Click="PpiZoom_Click"
                            FontFamily="Consolas"
                            FontSize="10"
                            Cursor="Hand"
                            Background="#081008"
                            Foreground="#336633"
                            BorderBrush="#1a3a1a"
                            BorderThickness="1"
                            Padding="5,1"
                            Margin="1,0,0,0" />
                </StackPanel>
            </Grid>

            <Viewbox Grid.Row="1"
                     Stretch="Uniform"
                     Margin="6,2,6,6"
                     VerticalAlignment="Bottom">
                <Canvas Width="400"
                        Height="220"
                        x:Name="PpiCanvas">
                    <!-- Semicircle background -->
                    <Path Fill="#060a06"
                          Stroke="Transparent">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,210"
                                            IsClosed="True">
                                    <ArcSegment Point="400,210"
                                                Size="200,200"
                                                SweepDirection="Clockwise"
                                                IsLargeArc="False" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Distance rings -->
                    <Path Stroke="#008800"
                          StrokeThickness="0.9"
                          Opacity="0.85">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="160,210">
                                    <ArcSegment Point="240,210"
                                                Size="40,40"
                                                SweepDirection="Clockwise" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Path Stroke="#008800"
                          StrokeThickness="0.9"
                          Opacity="0.85">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="120,210">
                                    <ArcSegment Point="280,210"
                                                Size="80,80"
                                                SweepDirection="Clockwise" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Path Stroke="#00aa00"
                          StrokeThickness="1.0"
                          Opacity="0.9">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="80,210">
                                    <ArcSegment Point="320,210"
                                                Size="120,120"
                                                SweepDirection="Clockwise" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Path Stroke="#00aa00"
                          StrokeThickness="1.0"
                          Opacity="0.9">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="40,210">
                                    <ArcSegment Point="360,210"
                                                Size="160,160"
                                                SweepDirection="Clockwise" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Path Stroke="#00cc00"
                          StrokeThickness="1.5">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,210">
                                    <ArcSegment Point="400,210"
                                                Size="200,200"
                                                SweepDirection="Clockwise" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Line X1="0"
                          Y1="210"
                          X2="400"
                          Y2="210"
                          Stroke="#00cc00"
                          StrokeThickness="1.5" />

                    <!-- Angle guide lines -->
                    <Line X1="200"
                          Y1="210"
                          X2="27"
                          Y2="110"
                          Stroke="#007700"
                          StrokeThickness="0.7"
                          StrokeDashArray="3 4"
                          Opacity="0.9" />
                    <Line X1="200"
                          Y1="210"
                          X2="100"
                          Y2="37"
                          Stroke="#007700"
                          StrokeThickness="0.7"
                          StrokeDashArray="3 4"
                          Opacity="0.9" />
                    <Line X1="200"
                          Y1="210"
                          X2="200"
                          Y2="10"
                          Stroke="#00aa00"
                          StrokeThickness="1.1" />
                    <Line X1="200"
                          Y1="210"
                          X2="300"
                          Y2="37"
                          Stroke="#007700"
                          StrokeThickness="0.7"
                          StrokeDashArray="3 4"
                          Opacity="0.9" />
                    <Line X1="200"
                          Y1="210"
                          X2="373"
                          Y2="110"
                          Stroke="#007700"
                          StrokeThickness="0.7"
                          StrokeDashArray="3 4"
                          Opacity="0.9" />

                    <!-- Angle labels -->
                    <TextBlock Text="0°"
                               Canvas.Left="2"
                               Canvas.Top="193"
                               Foreground="#88cc88"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="30°"
                               Canvas.Left="4"
                               Canvas.Top="94"
                               Foreground="#88cc88"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="60°"
                               Canvas.Left="79"
                               Canvas.Top="22"
                               Foreground="#88cc88"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="90°"
                               Canvas.Left="193"
                               Foreground="#bbddbb"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Canvas.Top="-2" />
                    <TextBlock Text="120°"
                               Canvas.Left="291"
                               Canvas.Top="22"
                               Foreground="#88cc88"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="150°"
                               Canvas.Left="354"
                               Canvas.Top="94"
                               Foreground="#88cc88"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="180°"
                               Canvas.Left="366"
                               Canvas.Top="193"
                               Foreground="#88cc88"
                               FontFamily="Consolas"
                               FontSize="11" />

                    <!-- Range labels (updated dynamically on zoom) -->
                    <TextBlock x:Name="RingLabel1"
                               Text="2m"
                               Canvas.Left="203"
                               Canvas.Top="173"
                               Foreground="#77bb77"
                               FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Top"
                               RenderTransformOrigin="0.512,0.05"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="RingLabel2"
                               Text="4m"
                               Canvas.Left="203"
                               Canvas.Top="133"
                               Foreground="#77bb77"
                               FontFamily="Consolas"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="RingLabel3"
                               Text="6m"
                               Canvas.Left="203"
                               Canvas.Top="92"
                               Foreground="#77bb77"
                               FontFamily="Consolas"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="RingLabel4"
                               Text="8m"
                               Canvas.Left="203"
                               Canvas.Top="51"
                               Foreground="#77bb77"
                               FontFamily="Consolas"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top" />

                    <TextBlock x:Name="RingLabel5"
                               Text="10m"
                               Canvas.Left="203"
                               Canvas.Top="12"
                               Foreground="#77bb77"
                               FontFamily="Consolas"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top" />

                    <!-- Sweep trail lines (pre-allocated in code-behind) -->
                    <Canvas x:Name="TrailCanvas"
                            Width="400"
                            Height="220"
                            IsHitTestVisible="False" />

                    <!-- Dynamic obstacle dot layer (cartesian world coords) -->
                    <Canvas x:Name="ObstacleDotCanvas"
                            Width="400"
                            Height="220"
                            IsHitTestVisible="False" />

                    <!-- Dynamic LiDAR dot layer -->
                    <Canvas x:Name="LidarDotCanvas"
                            Width="400"
                            Height="220"
                            IsHitTestVisible="False" />

                    <!-- Scan line glow: wider soft bloom behind the bright line -->
                    <Line x:Name="GlowLine"
                          X1="200"
                          Y1="210"
                          X2="200"
                          Y2="10"
                          Stroke="#00ff44"
                          StrokeThickness="10"
                          Opacity="0.10"
                          IsHitTestVisible="False" />

                    <!-- Scan line (animated by code-behind) -->
                    <Line x:Name="ScanLine"
                          X1="200"
                          Y1="210"
                          X2="200"
                          Y2="10"
                          Stroke="#00ff88"
                          StrokeThickness="1.6"
                          Opacity="1.0"
                          IsHitTestVisible="False" />

                    <!-- Origin dot -->
                    <Ellipse Canvas.Left="196"
                             Canvas.Top="206"
                             Width="8"
                             Height="8"
                             Fill="#00ff88"
                             Stroke="#00bb66"
                             StrokeThickness="1" />
                </Canvas>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
