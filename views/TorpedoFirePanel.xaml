<UserControl x:Class="AquaVectorUI.views.TorpedoFirePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorder}" Padding="0,4,0,8" BorderBrush="#3a1010">
        <StackPanel>
            <TextBlock Text="▸ 어뢰 발사" Style="{StaticResource SectionTitle}" Foreground="#ff8888"/>

            <Grid Margin="8,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TargetWorldX, StringFormat='{}{0:F2} m'}"
                           Foreground="#44aaff" FontFamily="Consolas" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="8,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Y" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TargetWorldY, StringFormat='{}{0:F2} m'}"
                           Foreground="#44aaff" FontFamily="Consolas" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="8,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="방위" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TargetHeadingDeg, StringFormat='{}{0:F1}°'}"
                           Foreground="#44aaff" FontFamily="Consolas" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="8,2,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="속도" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TargetSpeedMs, StringFormat='{}{0:F2} m/s'}"
                           Foreground="#44aaff" FontFamily="Consolas" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Button Content="🚀  발사  FIRE"
                    Margin="8,0,8,0" Height="36" HorizontalAlignment="Stretch"
                    Command="{Binding FireCommand}"
                    Style="{StaticResource FireButton}"/>
        </StackPanel>
    </Border>
</UserControl>
